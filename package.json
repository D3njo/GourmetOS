{
  "name": "gourmetos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Weather-adaptive haute cuisine meal planner PWA",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test:syntax": "node scripts/check-js-syntax.js",
    "test:data": "node scripts/validate-data.cjs && node scripts/test-weather-buckets.cjs",
    "test:measures": "node scripts/test-measures.cjs",
    "test:exclusions": "node scripts/test-exclusions.cjs",
    "test:diet": "node scripts/test-diet-preferences.cjs",
    "test:inventory": "node scripts/test-home-inventory.cjs",
    "test:release-smoke": "node scripts/release-smoke.cjs",
    "test": "npm run test:syntax && npm run test:data && npm run test:measures && npm run test:exclusions && npm run test:diet && npm run test:inventory && npm run test:release-smoke",
    "test:compliance": "node scripts/validate-data.cjs",
    "build:data": "node scripts/build-recipe-index.cjs",
    "patch:data": "node scripts/patch-recipe-data.cjs",
    "patch:tags": "node scripts/patch-recipe-index-tags.cjs",
    "expand:catalog": "node scripts/expand-catalog-seeds.cjs",
    "curate:catalog": "node scripts/curate-premium-catalog.cjs",
    "icons:build": "bash scripts/generate-icons.sh"
  }
}
